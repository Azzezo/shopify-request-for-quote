{% comment %}
  RFQ Global Embed
  This app embed runs on ALL pages to:
  1. Hide prices and add-to-cart buttons for RFQ products on collection pages
  2. Hide prices from SEO structured data (JSON-LD)
  3. Add working "Request Quote" buttons with modal to RFQ products
  
  IMPORTANT: This must be ENABLED in Theme Editor > App Embeds
{% endcomment %}

<style id="rfq-global-styles">
  /* ===========================================
     PENDING STATE - Hide while loading RFQ status
     Prevents flash of price/cart before JS runs
     =========================================== */
  .rfq-pending .price,
  .rfq-pending .price__container,
  .rfq-pending .product-price,
  .rfq-pending .product__price,
  .rfq-pending [data-price],
  .rfq-pending .money,
  .rfq-pending .quick-add,
  .rfq-pending .quick-add-button,
  .rfq-pending quick-add-modal,
  .rfq-pending quick-add-button,
  .rfq-pending .quick-add__submit,
  .rfq-pending .quick-add-modal,
  .rfq-pending .quick-add-wrapper,
  .rfq-pending .quick-shop,
  .rfq-pending [data-quick-add],
  .rfq-pending [data-quick-buy],
  .rfq-pending .card__button,
  .rfq-pending .add-to-cart,
  .rfq-pending [data-add-to-cart],
  .rfq-pending .product-form__submit,
  .rfq-pending .btn-addtocart,
  .rfq-pending form[action*="/cart/add"],
  .rfq-pending product-form,
  .rfq-pending .shopify-payment-button {
    opacity: 0 !important;
    pointer-events: none !important;
  }
  
  /* ===========================================
     PRICE HIDING - Applied to .rfq-hide-price containers
     =========================================== */
  .rfq-hide-price .price,
  .rfq-hide-price .price__container,
  .rfq-hide-price .price-box,
  .rfq-hide-price .product-price,
  .rfq-hide-price .price-item,
  .rfq-hide-price .product__price,
  .rfq-hide-price [data-price],
  .rfq-hide-price .money,
  .rfq-hide-price .price--on-sale,
  .rfq-hide-price .price-regular,
  .rfq-hide-price .price-sale,
  .rfq-hide-price .price__regular,
  .rfq-hide-price .price__sale,
  .rfq-hide-price .card__information .price,
  .rfq-hide-price .card-information .price,
  .rfq-hide-price .product-card__price,
  .rfq-hide-price .product-item__price,
  .rfq-hide-price .product-grid-item__price,
  .rfq-hide-price .collection-product-card__price,
  .rfq-hide-price span[class*="price"],
  .rfq-hide-price div[class*="price"],
  .rfq-hide-price .price-wrapper,
  .rfq-hide-price .price-container,
  .rfq-hide-price [class*="ProductPrice"],
  .rfq-hide-price [class*="product-price"],
  .rfq-hide-price [class*="Price"],
  .rfq-hide-price .product-tile__price,
  .rfq-hide-price .grid-product__price,
  .rfq-hide-price .product-card-info__price,
  /* Clenli theme specific */
  .rfq-hide-price .product__price-and-badge,
  .rfq-hide-price .tax-note,
  .rfq-hide-price .unit-price {
    display: none !important;
    visibility: hidden !important;
  }
  
  /* ===========================================
     CART BUTTON HIDING - Applied to .rfq-hide-cart containers
     =========================================== */
  .rfq-hide-cart .quick-add,
  .rfq-hide-cart .quick-add-button,
  .rfq-hide-cart .quick-add__submit,
  .rfq-hide-cart .product-form__submit,
  .rfq-hide-cart .add-to-cart,
  .rfq-hide-cart [data-add-to-cart],
  .rfq-hide-cart .btn-addtocart,
  .rfq-hide-cart .btn-add-to-cart,
  .rfq-hide-cart .card__button,
  .rfq-hide-cart .product-card__button,
  .rfq-hide-cart .product-item__button,
  .rfq-hide-cart .quick-buy,
  .rfq-hide-cart .quick-buy-button,
  .rfq-hide-cart .add-to-cart-button,
  .rfq-hide-cart button[name="add"],
  .rfq-hide-cart [type="submit"][name="add"],
  .rfq-hide-cart .product-card__add-button,
  .rfq-hide-cart .grid-product__add-to-cart,
  .rfq-hide-cart .product-tile__add-to-cart,
  .rfq-hide-cart form[action*="/cart/add"] button,
  .rfq-hide-cart form[action*="/cart/add"],
  .rfq-hide-cart quick-add-modal,
  .rfq-hide-cart quick-add-button,
  .rfq-hide-cart .quick-add-modal,
  .rfq-hide-cart .quick-add-wrapper,
  .rfq-hide-cart .quick-shop,
  .rfq-hide-cart .quick-shop-btn,
  .rfq-hide-cart [data-quick-add],
  .rfq-hide-cart [data-quick-buy],
  .rfq-hide-cart product-form,
  /* Clenli theme specific */
  .rfq-hide-cart .shopify-payment-button,
  .rfq-hide-cart .dynamic-checkout,
  .rfq-hide-cart .additional-checkout-buttons {
    display: none !important;
    visibility: hidden !important;
  }
  
  /* ===========================================
     RFQ BUTTON - Clickable button on collection pages
     Inherits the theme's native .button styling.
     Only overrides what is needed for positioning/clickability.
     =========================================== */
  .rfq-collection-btn {
    margin-top: 0;
    cursor: pointer !important;
    font-family: inherit;
    text-align: center !important;
    width: 100%;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    /* Critical: ensure button is clickable above card overlays */
    position: relative !important;
    z-index: 100 !important;
    pointer-events: auto !important;
  }
  
  /* Position the button nicely in cards */
  .rfq-hide-cart .rfq-collection-btn {
    display: flex !important;
    visibility: visible !important;
  }
  
  /* Ensure parent containers don't block clicks */
  [data-rfq-handle] .rfq-collection-btn {
    position: relative !important;
    z-index: 100 !important;
  }

  /* ===========================================
     RFQ GLOBAL MODAL
     =========================================== */
  .rfq-global-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 999999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .rfq-global-modal.rfq-modal-open {
    display: flex;
  }

  .rfq-global-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .rfq-global-content {
    position: relative;
    background: #ffffff;
    border-radius: 16px;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    animation: rfqModalSlideIn 0.3s ease-out;
  }

  @keyframes rfqModalSlideIn {
    from {
      opacity: 0;
      transform: translateY(-20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .rfq-global-header {
    padding: 24px 24px 16px;
    border-bottom: 1px solid #e5e7eb;
    position: relative;
  }

  .rfq-global-title {
    font-size: 22px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 4px 0;
    padding-right: 40px;
  }

  .rfq-global-product {
    font-size: 14px;
    color: #6b7280;
    margin: 0;
  }

  .rfq-global-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 36px;
    height: 36px;
    border: none;
    background: #f3f4f6;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    color: #6b7280;
  }

  .rfq-global-close:hover {
    background: #e5e7eb;
    color: #111827;
  }

  .rfq-global-form {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .rfq-global-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .rfq-global-label {
    font-size: 14px;
    font-weight: 500;
    color: #374151;
  }

  .rfq-global-required {
    color: #ef4444;
  }

  .rfq-global-input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 15px;
    transition: all 0.2s;
    box-sizing: border-box;
    font-family: inherit;
  }

  .rfq-global-input:focus {
    outline: none;
    border-color: #6fb31a;
    box-shadow: 0 0 0 3px rgba(111, 179, 26, 0.15);
  }

  .rfq-global-input::placeholder {
    color: #9ca3af;
  }

  textarea.rfq-global-input {
    min-height: 100px;
    resize: vertical;
  }

  .rfq-global-submit {
    width: 100%;
    padding: 14px 20px;
    background: #6fb31a;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 8px;
  }

  .rfq-global-submit:hover:not(:disabled) {
    background: #5a9416;
  }

  .rfq-global-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .rfq-global-spinner {
    display: none;
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: rfqSpin 0.8s linear infinite;
  }

  @keyframes rfqSpin {
    to { transform: rotate(360deg); }
  }

  .rfq-global-submit.loading .rfq-global-spinner {
    display: block;
  }

  .rfq-global-submit.loading .rfq-submit-text {
    display: none;
  }

  .rfq-global-success,
  .rfq-global-error {
    display: none;
    padding: 24px;
    text-align: center;
  }

  .rfq-global-success.show,
  .rfq-global-error.show {
    display: block;
  }

  .rfq-global-success-icon {
    width: 64px;
    height: 64px;
    background: #d1fae5;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    color: #059669;
  }

  .rfq-global-success h3 {
    font-size: 20px;
    font-weight: 600;
    color: #111827;
    margin: 0 0 8px 0;
  }

  .rfq-global-success p {
    color: #6b7280;
    margin: 0 0 20px 0;
  }

  .rfq-global-success-close {
    padding: 12px 24px;
    background: #6fb31a;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }

  .rfq-global-success-close:hover {
    background: #5a9416;
  }

  .rfq-global-error-msg {
    color: #dc2626;
    font-size: 14px;
    padding: 12px;
    background: #fef2f2;
    border-radius: 8px;
    margin-bottom: 16px;
  }

  /* Mobile responsive */
  @media (max-width: 480px) {
    .rfq-global-content {
      max-height: 95vh;
      margin: 10px;
    }
    
    .rfq-global-header {
      padding: 20px 20px 14px;
    }
    
    .rfq-global-form {
      padding: 20px;
    }
    
    .rfq-global-title {
      font-size: 18px;
    }
  }
</style>

<!-- Shared RFQ Modal for Collection Pages -->
<div id="rfq-global-modal" class="rfq-global-modal">
  <div class="rfq-global-overlay"></div>
  <div class="rfq-global-content">
    <div class="rfq-global-header">
      <h2 class="rfq-global-title">Request a Quote</h2>
      <p class="rfq-global-product" id="rfq-global-product-name"></p>
      <button type="button" class="rfq-global-close" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    
    <div class="rfq-global-form" id="rfq-global-form">
      <div class="rfq-global-field">
        <label class="rfq-global-label">Name <span class="rfq-global-required">*</span></label>
        <input type="text" name="customerName" required class="rfq-global-input" placeholder="Your name" value="{{ customer.name | escape }}">
      </div>
      
      <div class="rfq-global-field">
        <label class="rfq-global-label">Email <span class="rfq-global-required">*</span></label>
        <input type="email" name="customerEmail" required class="rfq-global-input" placeholder="your.email@example.com" value="{{ customer.email | escape }}">
      </div>
      
      <div class="rfq-global-field">
        <label class="rfq-global-label">Phone <span class="rfq-global-required">*</span></label>
        <input type="tel" name="customerPhone" required class="rfq-global-input" placeholder="+353 1 234 5678" value="{{ customer.default_address.phone | escape }}">
      </div>
      
      <div class="rfq-global-field">
        <label class="rfq-global-label">Message</label>
        <textarea name="requestDetails" class="rfq-global-input" placeholder="Any specific requirements or questions..."></textarea>
      </div>
      
      <button type="button" class="rfq-global-submit" id="rfq-global-submit">
        <span class="rfq-submit-text">Submit Quote Request</span>
        <span class="rfq-global-spinner"></span>
      </button>
      
      <div class="rfq-global-error-msg" id="rfq-global-error" style="display: none;"></div>
    </div>
    
    <div class="rfq-global-success" id="rfq-global-success">
      <div class="rfq-global-success-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h3>Quote Request Sent!</h3>
      <p>We'll get back to you as soon as possible.</p>
      <button type="button" class="rfq-global-success-close">Close</button>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';
  
  const SHOP = '{{ shop.permanent_domain }}';
  const DEBUG = false; // Set to true for console logging
  
  function log(...args) {
    if (DEBUG) console.log('[RFQ Global]', ...args);
  }
  
  // State
  const rfqCache = new Map();
  const buttonsAdded = new Set(); // Track handles that already have buttons
  let pendingHandles = new Set();
  let fetchTimeout = null;
  let currentProduct = null;
  let processTimeout = null; // Used by MutationObserver debounce
  
  // Modal elements
  const modal = document.getElementById('rfq-global-modal');
  const overlay = modal?.querySelector('.rfq-global-overlay');
  const closeBtn = modal?.querySelector('.rfq-global-close');
  const form = document.getElementById('rfq-global-form');
  const submitBtn = document.getElementById('rfq-global-submit');
  const successDiv = document.getElementById('rfq-global-success');
  const errorDiv = document.getElementById('rfq-global-error');
  const productNameEl = document.getElementById('rfq-global-product-name');
  const successCloseBtn = modal?.querySelector('.rfq-global-success-close');
  
  // Selectors
  const PRODUCT_LINK_SELECTORS = [
    'a[href*="/products/"]',
    '[data-product-handle]',
    '[data-handle]'
  ].join(',');
  
  const PRODUCT_CONTAINER_SELECTORS = [
    '.product-card',
    '.product-item', 
    '.product-grid-item',
    '.collection-product-card',
    '.card--product',
    '.card-wrapper',
    '.card',
    '.grid__item',
    '.product-card-wrapper',
    'li.grid__item',
    '.product',
    '.featured-product',
    '.product-tile',
    '.grid-product',
    '.collection-item',
    '.card-product',
    'product-card',
    '.product-block',
    '.product-item-container',
    '[data-product-card]'
  ];
  
  // Extract product handle from URL
  function getHandleFromUrl(url) {
    if (!url) return null;
    try {
      const match = url.match(/\/products\/([^\/\?#]+)/);
      return match ? decodeURIComponent(match[1]) : null;
    } catch (e) {
      return null;
    }
  }
  
  // Find the product container
  function findProductContainer(element) {
    for (const selector of PRODUCT_CONTAINER_SELECTORS) {
      try {
        const container = element.closest(selector);
        if (container) return container;
      } catch (e) {
        continue;
      }
    }
    return element.closest('[data-product-handle]') || element.closest('[data-handle]') || element.parentElement?.parentElement;
  }
  
  // Get product title from container
  function getProductTitle(container, handle) {
    // Try various selectors for product title
    const titleSelectors = [
      '.card__heading a',
      '.card__heading',
      '.product-card__title',
      '.product-item__title',
      '.product__title',
      '.product-title',
      '[data-product-title]',
      'h3 a',
      'h2 a',
      '.title a',
      '.product-card-title',
      '.grid-product__title'
    ];
    
    for (const selector of titleSelectors) {
      const el = container.querySelector(selector);
      if (el && el.textContent.trim()) {
        return el.textContent.trim();
      }
    }
    
    // Fallback: format handle
    return handle.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  }
  
  // Get product URL from container
  function getProductUrl(container, handle) {
    const link = container.querySelector('a[href*="/products/"]');
    return link?.href || `/products/${handle}`;
  }
  
  // Modal functions
  function openModal(product) {
    if (!modal) return;
    
    currentProduct = product;
    productNameEl.textContent = product.title;
    
    // Reset form state
    form.style.display = 'flex';
    successDiv.classList.remove('show');
    errorDiv.style.display = 'none';
    submitBtn.classList.remove('loading');
    submitBtn.disabled = false;
    
    modal.classList.add('rfq-modal-open');
    document.body.style.overflow = 'hidden';
    
    // Focus first input
    setTimeout(() => {
      const firstInput = form.querySelector('input');
      if (firstInput) firstInput.focus();
    }, 100);
  }
  
  function closeModal() {
    if (!modal) return;
    
    modal.classList.remove('rfq-modal-open');
    document.body.style.overflow = '';
    currentProduct = null;
    
    /* Clear non-prefilled fields (keep name/email/phone for convenience) */
    const textarea = form?.querySelector('textarea[name="requestDetails"]');
    if (textarea) textarea.value = '';
  }
  
  // Event listeners for modal
  if (overlay) overlay.addEventListener('click', closeModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (successCloseBtn) successCloseBtn.addEventListener('click', closeModal);
  
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('rfq-modal-open')) {
      closeModal();
    }
  });
  
  // Form submission
  if (submitBtn) {
    submitBtn.addEventListener('click', async () => {
      if (!currentProduct) return;
      
      const nameInput = form.querySelector('input[name="customerName"]');
      const emailInput = form.querySelector('input[name="customerEmail"]');
      const phoneInput = form.querySelector('input[name="customerPhone"]');
      const detailsInput = form.querySelector('textarea[name="requestDetails"]');
      
      // Validation
      if (!nameInput.value.trim()) {
        alert('Please enter your name');
        nameInput.focus();
        return;
      }
      
      if (!emailInput.value.trim()) {
        alert('Please enter your email');
        emailInput.focus();
        return;
      }
      
      // Validate email format
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(emailInput.value.trim())) {
        alert('Please enter a valid email address');
        emailInput.focus();
        return;
      }
      
      if (!phoneInput.value.trim()) {
        alert('Please enter your phone number');
        phoneInput.focus();
        return;
      }
      
      // Show loading
      submitBtn.classList.add('loading');
      submitBtn.disabled = true;
      errorDiv.style.display = 'none';
      
      // Build form data
      const formData = new FormData();
      formData.append('shop', SHOP);
      formData.append('productId', currentProduct.id || '');
      formData.append('productTitle', currentProduct.title);
      formData.append('productVariantId', '');
      formData.append('variantTitle', '');
      formData.append('customerName', nameInput.value);
      formData.append('customerEmail', emailInput.value);
      formData.append('customerPhone', phoneInput.value || '');
      formData.append('requestDetails', detailsInput.value || `Quote request for ${currentProduct.title}`);
      
      try {
        const response = await fetch('/apps/rfq', {
          method: 'POST',
          body: formData,
        });
        
        const result = await response.json();
        
        if (result.success) {
          form.style.display = 'none';
          successDiv.classList.add('show');
        } else {
          errorDiv.textContent = result.error || 'Something went wrong. Please try again.';
          errorDiv.style.display = 'block';
        }
      } catch (error) {
        console.error('RFQ submission error:', error);
        errorDiv.textContent = 'Network error. Please try again.';
        errorDiv.style.display = 'block';
      } finally {
        submitBtn.classList.remove('loading');
        submitBtn.disabled = false;
      }
    });
  }
  
  // Create RFQ button for a product
  // Uses theme button classes so the button matches the store's native styling
  function createRfqButton(container, handle) {
    const title = getProductTitle(container, handle);
    const url = getProductUrl(container, handle);
    
    const btn = document.createElement('button');
    btn.type = 'button';
    // Add theme-native button classes so the button inherits the store's styling
    btn.className = 'rfq-collection-btn button button--primary btn btn--primary';
    btn.setAttribute('data-rfq-btn', 'true');
    btn.setAttribute('data-rfq-title', title);
    btn.setAttribute('data-rfq-handle', handle);
    btn.setAttribute('data-rfq-url', url);
    btn.setAttribute('data-product-id', container.dataset.productId || '');
    btn.textContent = 'Request Quote';
    
    return btn;
  }
  
  // Global click handler using event delegation (more reliable)
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('.rfq-collection-btn, [data-rfq-btn]');
    if (btn) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      
      console.log('[RFQ Global] Button clicked!', btn);
      
      openModal({
        handle: btn.getAttribute('data-rfq-handle') || '',
        title: btn.getAttribute('data-rfq-title') || 'Product',
        url: btn.getAttribute('data-rfq-url') || '',
        id: btn.getAttribute('data-product-id') || ''
      });
      
      return false;
    }
  }, true); // Use capture phase to catch event first
  
  // Batch fetch RFQ status
  async function fetchRfqStatus(handles) {
    if (handles.length === 0) return;
    
    log('Fetching RFQ status for:', handles);
    
    try {
      const response = await fetch(`/apps/rfq?action=check-products&shop=${SHOP}&handles=${handles.join(',')}`);
      if (!response.ok) {
        console.warn('RFQ Global: Failed to fetch product status');
        return;
      }
      
      const data = await response.json();
      log('RFQ status response:', data);
      
      if (data.products) {
        for (const [handle, status] of Object.entries(data.products)) {
          rfqCache.set(handle, status);
        }
      }
      
      for (const handle of handles) {
        if (!rfqCache.has(handle)) {
          rfqCache.set(handle, { rfqEnabled: false, hidePrice: false });
        }
      }
      
      applyStyles();
      hideSeoData();
    } catch (error) {
      console.warn('RFQ Global: Error fetching product status:', error);
    }
  }
  
  function queueHandleFetch(handle) {
    if (rfqCache.has(handle) || pendingHandles.has(handle)) return;
    
    pendingHandles.add(handle);
    
    clearTimeout(fetchTimeout);
    fetchTimeout = setTimeout(() => {
      const handles = Array.from(pendingHandles);
      pendingHandles.clear();
      fetchRfqStatus(handles);
    }, 150);
  }
  
  // Apply styles and buttons to products
  function applyStyles() {
    // Check if we're on a product page (skip button insertion, let rfq-button.liquid handle it)
    const isProductPage = /\/products\/[^\/]+/.test(window.location.pathname);
    // Check if we're on the homepage (skip button insertion - only show on collection/search pages)
    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    const isHomePage = path === '/' || path === '';
    
    document.querySelectorAll('[data-rfq-handle]').forEach(element => {
      const handle = element.dataset.rfqHandle;
      const status = rfqCache.get(handle);
      
      // Remove pending state
      element.classList.remove('rfq-pending');
      
      if (!status?.rfqEnabled) {
        // Not RFQ-enabled, show everything back
        element.classList.remove('rfq-hide-cart');
        element.classList.remove('rfq-hide-price');
        return;
      }
      
      // RFQ is enabled
      element.classList.add('rfq-hide-cart');
      
      if (status.hidePrice) {
        element.classList.add('rfq-hide-price');
      } else {
        element.classList.remove('rfq-hide-price');
      }
      
      // Skip button insertion on product pages and homepage
      if (isProductPage || isHomePage) {
        return;
      }
      
      // Skip if this handle already has a button anywhere on the page
      if (buttonsAdded.has(handle)) {
        return;
      }
      
      // Skip if this specific element already has a button
      if (element.querySelector('.rfq-collection-btn')) {
        buttonsAdded.add(handle);
        return;
      }
      
      const btn = createRfqButton(element, handle);
      
      // Find a good place to insert the button (try only the FIRST match)
      const insertTargets = [
        '.card__content',
        '.card__information',
        '.product-card__info',
        '.product-item__info',
        '.card-information',
        '.product-card-info',
        '.product__info',
        '.grid-product__content'
      ];
      
      let inserted = false;
      for (const selector of insertTargets) {
        const target = element.querySelector(selector);
        if (target) {
          target.appendChild(btn);
          inserted = true;
          break;
        }
      }
      
      // Fallback: insert at end of container
      if (!inserted) {
        element.appendChild(btn);
      }
      
      // Mark this handle as having a button globally
      buttonsAdded.add(handle);
      
      log(`Applied RFQ to ${handle}`);
    });
  }
  
  // Hide SEO data
  function hideSeoData() {
    document.querySelectorAll('script[type="application/ld+json"]').forEach(script => {
      try {
        const data = JSON.parse(script.textContent);
        let modified = false;
        
        if (data['@type'] === 'Product') {
          const handle = getProductHandle();
          if (handle && rfqCache.has(handle)) {
            const status = rfqCache.get(handle);
            if (status?.rfqEnabled && status?.hidePrice) {
              delete data.offers;
              delete data.price;
              delete data.priceCurrency;
              modified = true;
            }
          }
        }
        
        if (data['@type'] === 'ProductGroup' || Array.isArray(data)) {
          const products = Array.isArray(data) ? data : [data];
          products.forEach(product => {
            if (product['@type'] === 'Product' && product.url) {
              const handle = getHandleFromUrl(product.url);
              if (handle && rfqCache.has(handle)) {
                const status = rfqCache.get(handle);
                if (status?.rfqEnabled && status?.hidePrice) {
                  delete product.offers;
                  delete product.price;
                  delete product.priceCurrency;
                  modified = true;
                }
              }
            }
          });
        }
        
        if (modified) {
          script.textContent = JSON.stringify(data);
        }
      } catch (e) {}
    });
    
    const currentHandle = getProductHandle();
    if (currentHandle && rfqCache.has(currentHandle)) {
      const status = rfqCache.get(currentHandle);
      if (status?.rfqEnabled && status?.hidePrice) {
        document.querySelectorAll('meta[property*="price"]').forEach(tag => {
          tag.setAttribute('content', '');
        });
      }
    }
  }
  
  function getProductHandle() {
    return getHandleFromUrl(window.location.pathname);
  }
  
  // Process a product element
  function processElement(element) {
    if (element.closest('.rfq-modal') || element.closest('.rfq-global-modal')) return;
    
    // Skip if this element is inside an already-processed container
    if (element.closest('[data-rfq-handle]')) return;
    
    let handle = element.dataset?.productHandle || element.dataset?.handle;
    
    if (!handle) {
      const href = element.href || element.querySelector('a[href*="/products/"]')?.href;
      handle = getHandleFromUrl(href);
    }
    
    if (!handle) return;
    
    const container = findProductContainer(element);
    if (!container) return;
    
    // Skip if already processed
    if (container.dataset.rfqHandle) return;
    
    // Skip if this container is inside another rfq-handle container (nested)
    if (container.parentElement?.closest('[data-rfq-handle]')) return;
    
    container.dataset.rfqHandle = handle;
    
    // Hide cart immediately to prevent flash of content (will show back if not RFQ-enabled)
    // Only hide cart buttons preemptively; price hiding waits for API confirmation
    container.classList.add('rfq-pending');
    container.classList.add('rfq-hide-cart');
    
    if (rfqCache.has(handle)) {
      const status = rfqCache.get(handle);
      container.classList.remove('rfq-pending');
      if (!status?.rfqEnabled) {
        // Not RFQ-enabled, show back
        container.classList.remove('rfq-hide-cart');
      } else if (status.hidePrice) {
        // RFQ enabled AND hide price
        container.classList.add('rfq-hide-price');
      }
    } else {
      queueHandleFetch(handle);
    }
  }
  
  // Quick View / Quick Shop detection
  // Themes inject modals/drawers dynamically with full product details.
  // We need to detect these and hide prices/cart for RFQ products.
  const QUICKVIEW_SELECTORS = [
    'quick-add-modal',
    '.quick-add-modal',
    '.quick-view-modal',
    '.quickview-modal',
    '.quick-view',
    '.quickview',
    '.quick-shop-modal',
    '.quick-shop',
    '.product-quick-view',
    '.product-quickview',
    '[data-quick-view]',
    '[data-quickview]',
    '[data-quick-add-modal]',
    '.drawer--quick-view',
    '.drawer--quickview',
    '.modal--quick-view',
    '.modal--quickview',
    // Clenli / common theme patterns
    '.quick-view-content',
    '.quickshop-content',
    '.product-popup',
    '.product-modal',
    '.product-drawer'
  ];

  function processQuickViews() {
    for (const selector of QUICKVIEW_SELECTORS) {
      document.querySelectorAll(selector).forEach(processQuickViewElement);
    }
  }

  function processQuickViewElement(modal) {
    if (modal.dataset.rfqProcessed) return;

    // Try to find the product handle from a link, form action, or data attribute inside the modal
    let handle = null;

    const productLink = modal.querySelector('a[href*="/products/"]');
    if (productLink) {
      handle = getHandleFromUrl(productLink.href);
    }

    if (!handle) {
      const form = modal.querySelector('form[action*="/cart/add"]');
      if (form) {
        // Some forms have a data attribute or hidden input with the product URL
        const productUrl = form.closest('[data-product-url]')?.dataset?.productUrl;
        if (productUrl) handle = getHandleFromUrl(productUrl);
      }
    }

    if (!handle) {
      // Check for a product URL in the modal's own data attributes
      const url = modal.dataset?.productUrl || modal.dataset?.url || modal.getAttribute('data-product-url');
      if (url) handle = getHandleFromUrl(url);
    }

    if (!handle) {
      // Try to extract from any /products/ link in the modal's inner HTML
      const allLinks = modal.querySelectorAll('a[href*="/products/"]');
      for (const link of allLinks) {
        const h = getHandleFromUrl(link.href);
        if (h) { handle = h; break; }
      }
    }

    if (!handle) return;

    modal.dataset.rfqProcessed = 'true';

    const status = rfqCache.get(handle);
    if (!status) {
      // We don't have status yet — fetch it and reprocess
      queueHandleFetch(handle);
      // Re-check after fetch resolves
      const checkInterval = setInterval(() => {
        if (rfqCache.has(handle)) {
          clearInterval(checkInterval);
          applyQuickViewStyles(modal, handle);
        }
      }, 100);
      // Stop checking after 5 seconds
      setTimeout(() => clearInterval(checkInterval), 5000);
      return;
    }

    applyQuickViewStyles(modal, handle);
  }

  function applyQuickViewStyles(modal, handle) {
    const status = rfqCache.get(handle);
    if (!status?.rfqEnabled) return;

    // Hide cart/buy buttons
    modal.classList.add('rfq-hide-cart');

    // Hide price if configured
    if (status.hidePrice) {
      modal.classList.add('rfq-hide-price');

      // Also hide price elements that don't match our class-based selectors
      // (some quick views use unique selectors)
      const priceSelectors = [
        '.price', '.price__container', '.product-price', '.product__price',
        '[data-price]', '.money', '.price-item', '.price--on-sale',
        '.price-regular', '.price-sale', '.price__regular', '.price__sale',
        '.product__price-and-badge', '.tax-note', '.unit-price',
        '.product-single__price', '.current-price', '.price-wrapper',
        '.price-container', 'span[class*="price"]', 'div[class*="price"]',
        '[class*="ProductPrice"]', '[class*="product-price"]',
        // Subtotal, quantity often shown in quick views
        '.subtotal', '[data-subtotal]', '.product-subtotal'
      ];
      modal.querySelectorAll(priceSelectors.join(',')).forEach(el => {
        el.style.display = 'none';
      });
    }

    // Hide quantity selector
    const qtySelectors = [
      '.quantity', '.quantity-selector', '.quantity__wrapper',
      '.product-form__quantity', '.product-quantity', '.product__quantity',
      '.quantity-wrapper', '.quantity-input', '.quantity__input',
      '[data-quantity-input]', '.qty-field', '.qty-wrapper',
      'label[for*="quantity"]', '.quantity__label'
    ];
    modal.querySelectorAll(qtySelectors.join(',')).forEach(el => {
      el.style.display = 'none';
    });

    // Hide add to cart / buy buttons
    const cartSelectors = [
      '.product-form__submit', 'button[name="add"]', '[data-add-to-cart]',
      '.add-to-cart', '.btn-addtocart', 'form[action*="/cart/add"] button[type="submit"]',
      '.shopify-payment-button', '.dynamic-checkout', '.additional-checkout-buttons'
    ];
    modal.querySelectorAll(cartSelectors.join(',')).forEach(el => {
      el.style.display = 'none';
    });

    log(`Applied RFQ styles to quick view for ${handle}`);
  }

  function processPage() {
    log('Processing page...');
    document.querySelectorAll(PRODUCT_LINK_SELECTORS).forEach(processElement);
    
    // Also check for quick view modals
    processQuickViews();
    
    const currentHandle = getProductHandle();
    if (currentHandle && !rfqCache.has(currentHandle)) {
      queueHandleFetch(currentHandle);
    }
  }
  
  function setupObserver() {
    const observer = new MutationObserver((mutations) => {
      let shouldProcess = false;
      let hasQuickView = false;
      
      for (const mutation of mutations) {
        for (const node of mutation.addedNodes) {
          if (node.nodeType === 1) {
            shouldProcess = true;
            // Check if any added node is or contains a quick view
            if (node.matches && QUICKVIEW_SELECTORS.some(s => {
              try { return node.matches(s) || node.querySelector(s); } catch(e) { return false; }
            })) {
              hasQuickView = true;
            }
          }
        }
        if (shouldProcess) break;
      }
      
      if (shouldProcess) {
        clearTimeout(processTimeout);
        // Process quick views faster since they're user-triggered and visible immediately
        processTimeout = setTimeout(processPage, hasQuickView ? 50 : 200);
      }
    });
    
    observer.observe(document.body, {
      childList: true,
      subtree: true
    });
  }
  
  function init() {
    log('Initializing RFQ Global...');
    processPage();
    setupObserver();
    
    document.addEventListener('shopify:section:load', processPage);
    document.addEventListener('shopify:section:select', processPage);
    document.addEventListener('turbo:load', processPage);
    document.addEventListener('page:load', processPage);
    
    let lastUrl = location.href;
    new MutationObserver(() => {
      if (location.href !== lastUrl) {
        lastUrl = location.href;
        setTimeout(processPage, 100);
      }
    }).observe(document.body, { subtree: true, childList: true });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  
  setTimeout(processPage, 1000);
  setTimeout(processPage, 3000);
})();
</script>

